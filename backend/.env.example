# Copy to /var/www/app/sibooking/backend/.env on the VPS.
# Backend-only configuration. Keep secrets here, not in deployment/frontend env files.

APP_NAME="Sibooking Backend"
APP_ENV=production
APP_DEBUG=false
SESSION_COOKIE_SECURE=true

# Optional override. Leave empty to let the app build the URL from DB_* values below.
DATABASE_URL=

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=sibooking_db
DB_USER=sibooking_user
DB_PASSWORD=change-me

SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

FRONTEND_URL=https://sibooking.keispace.cloud

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
