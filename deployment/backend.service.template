[Unit]
Description=${APP_NAME} FastAPI backend
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=${APP_OWNER}
Group=${APP_GROUP}
WorkingDirectory=${BACKEND_DIR}
EnvironmentFile=${BACKEND_ENV}
ExecStart=${BACKEND_DIR}/.venv/bin/uvicorn ${BACKEND_APP_MODULE} --host 127.0.0.1 --port ${BACKEND_PORT} --workers ${BACKEND_WORKERS}
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
