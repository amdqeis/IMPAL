# Copy this file to /var/www/app/sibooking/deployment/.env and adjust values.
# Deployment/server configuration only. Backend and frontend runtime env files stay separate.

APP_NAME=sibooking
DOMAIN=example.com
SSL_EMAIL=admin@example.com
GIT_BRANCH=main

PROJECT_ROOT=/var/www/app
PROJECT_DIR=/var/www/app/sibooking
FRONTEND_DIR=/var/www/app/sibooking/frontend
BACKEND_DIR=/var/www/app/sibooking/backend
DEPLOYMENT_DIR=/var/www/app/sibooking/deployment

BACKEND_ENV=/var/www/app/sibooking/backend/.env
FRONTEND_ENV=/var/www/app/sibooking/frontend/.env.production

# Leave empty on first setup to auto-select free ports.
BACKEND_PORT=
FRONTEND_PORT=
BACKEND_PORT_START=8000
FRONTEND_PORT_START=3000

BACKEND_APP_MODULE=main:app
BACKEND_WORKERS=1

# The user that owns and runs the application files/services.
APP_OWNER=deploy
APP_GROUP=deploy

# PostgreSQL on the VPS host. DATABASE_PASSWORD is required; setup.sh will fail if empty.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=sibooking_db
DATABASE_USER=sibooking_user
DATABASE_PASSWORD=

# Optional tuning.
CLIENT_MAX_BODY_SIZE=20M
NODE_MAJOR=22
