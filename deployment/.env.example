# Copy this file to /var/www/app/backend/.env and replace every placeholder value.
# The setup script reads DOMAIN and SSL_EMAIL from the same file when available.

# Core backend configuration.
APP_NAME=IMPAL Backend
APP_ENV=production
APP_DEBUG=false

# Primary PostgreSQL connection string used by SQLAlchemy.
DATABASE_URL=postgresql+psycopg2://impal_user:change-me@127.0.0.1:5432/impal_db

# Optional individual database fields kept for compatibility with the current app config.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=impal_db
DB_USER=impal_user
DB_PASSWORD=change-me

# Deployment settings consumed by setup.sh, Nginx, and the frontend CORS origin.
DOMAIN=example.com
SSL_EMAIL=admin@example.com
WWW_DOMAIN=www.example.com
FRONTEND_URL=https://example.com

# JWT settings.
# Keep JWT_SECRET for deployment documentation, and set SECRET_KEY because the backend reads that variable today.
JWT_SECRET=replace-with-a-long-random-string
SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
SESSION_COOKIE_SECURE=true
