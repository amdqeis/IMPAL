# Copy this file to one of these locations on the VPS:
# - /var/www/app/deployment/.env.production  (recommended)
# - /var/www/app/deployment/.env
# - /var/www/app/.env
#
# Then run:
# sudo bash deployment/scripts/setup.sh
# bash deployment/scripts/deploy.sh
#
# Do not commit real secrets. Replace every change-me value on the VPS.

# ---------------------------------------------------------------------------
# Deployment identity
# ---------------------------------------------------------------------------
# Used only by deployment/scripts for systemd service names, sockets, logs,
# and the Nginx site. Keep this lowercase and without spaces.
DEPLOY_APP_NAME=impal

# Project path on the VPS. GitHub Actions should SSH to this server and run
# bash deployment/scripts/deploy.sh from this repository.
PROJECT_DIR=/var/www/app
FRONTEND_DIR=frontend
BACKEND_DIR=backend
GIT_BRANCH=main

# FastAPI import path. This repository exposes backend/main.py with "app".
BACKEND_APP_MODULE=main:app
BACKEND_WORKERS=2

# Unix socket runtime paths. Leave these defaults unless you need custom paths.
RUN_DIR=/run/impal
LOG_DIR=/var/log/impal
BACKEND_SOCKET=/run/impal/backend.sock
FRONTEND_SOCKET=/run/impal/frontend.sock

# Linux service user/group. Nginx reads sockets through this group.
SERVICE_USER=impal
SERVICE_GROUP=www-data

# ---------------------------------------------------------------------------
# Domain, SSL, and public frontend/backend URLs
# ---------------------------------------------------------------------------
DOMAIN=example.com
EMAIL=admin@example.com

# Browser-side API URL compiled into Next.js at build time.
# Use /api for same-domain production behind Nginx.
NEXT_PUBLIC_API_BASE_URL=/api

# Backend CORS origin. For multiple origins, separate with commas.
FRONTEND_URL=https://example.com

# ---------------------------------------------------------------------------
# Backend app configuration
# ---------------------------------------------------------------------------
# APP_NAME is read by FastAPI as a display name. It is intentionally separate
# from DEPLOY_APP_NAME so it may contain spaces.
APP_NAME="IMPAL Backend"
APP_ENV=production
APP_DEBUG=false
SESSION_COOKIE_SECURE=true

# Primary SQLAlchemy connection string used by backend/app/core/config.py.
DATABASE_URL=postgresql+psycopg2://impal_user:change-me@127.0.0.1:5432/impal_db

# Optional fields used by setup.sh to create/update PostgreSQL idempotently.
# Keep these consistent with DATABASE_URL.
POSTGRES_DB=impal_db
POSTGRES_USER=impal_user
POSTGRES_PASSWORD=change-me

# Optional compatibility fields if DATABASE_URL is not set.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=impal_db
DB_USER=impal_user
DB_PASSWORD=change-me

# JWT/session settings.
SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional mail settings.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Set to false only if you intentionally deploy without DATABASE_URL.
REQUIRE_DATABASE_URL=true
