# Copy to /var/www/app/sibooking/deployment/.env on the VPS.
# This file is for deployment/server configuration only.
# Do not put backend application secrets here unless they are needed to
# bootstrap server infrastructure such as PostgreSQL role/database creation.

PROJECT_DIR=/var/www/app
APPNAME=sibooking
APP_DIR=/var/www/app/sibooking
FRONTEND_DIR=/var/www/app/sibooking/frontend
BACKEND_DIR=/var/www/app/sibooking/backend
DEPLOYMENT_DIR=/var/www/app/sibooking/deployment

DEPLOYMENT_ENV=/var/www/app/sibooking/deployment/.env
BACKEND_ENV=/var/www/app/sibooking/backend/.env
FRONTEND_ENV=/var/www/app/sibooking/frontend/.env.production

GIT_BRANCH=main
NODE_MAJOR=20

SERVICE_USER=sibooking
SERVICE_GROUP=www-data

DOMAIN=example.com
SSL_EMAIL=admin@example.com

BACKEND_APP_MODULE=main:app
BACKEND_WORKERS=2

# Unix-socket runtime. Leave defaults unless your VPS policy requires another path.
RUN_DIR=/run/sibooking
LOG_DIR=/var/log/sibooking
BACKEND_SOCKET=/run/sibooking/backend.sock
FRONTEND_SOCKET=/run/sibooking/frontend.sock

# Optional PostgreSQL bootstrap used by setup.sh only.
# Keep these consistent with backend DATABASE_URL if you enable them.
POSTGRES_DB=sibooking_db
POSTGRES_USER=sibooking_user
POSTGRES_PASSWORD=change-me
